+                        "prompt_tokens": request.num_prompt_tokens,
+                        "output_tokens": request.num_output_tokens,
+                    }
+                )
+                remaining -= 1
+            queues.append(
+                {"name": name, "num_requests": len(requests), "requests": entries}
+            )
+
+        return {
+            "data_parallel_rank": self.parallel_config.data_parallel_index,
+            "queues": queues,
+        }
